# Numeric IDs are examples, not credentials. Replace before running locally.
EHTG_OWNER_ID=123456789
EHTG_CHANNEL_ID=-1001234567890
EHTG_DATABASE_PATH=data/db/app.sqlite3
# Replace with the actual installed extension ID; JSON arrays are required.
EHTG_ALLOWED_ORIGINS=["chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
EHTG_ALLOWED_HOSTS=["localhost","127.0.0.1"]
EHTG_ROOT_PATH=
EHTG_MAX_PAGES=2000
EHTG_MAX_QUEUE=100
EHTG_MAX_BODY_BYTES=16384
EHTG_PAIRING_ATTEMPTS_PER_MINUTE=10
# Source analysis is opt-in until session/server access is verified.
EHTG_SOURCE_ENABLED=false
EHTG_SOURCE_SESSION_PATH=secrets/source-session.json
EHTG_SOURCE_REQUEST_INTERVAL=3
EHTG_SOURCE_REQUEST_TIMEOUT=20
EHTG_SOURCE_MAX_HTML_BYTES=2097152
EHTG_SOURCE_MAX_INDEX_PAGES=200
EHTG_SOURCE_MEMORY_MB=256
EHTG_ANALYSIS_TIMEOUT=900
EHTG_ANALYSIS_LEASE_SECONDS=30
EHTG_ANALYSIS_MAX_ATTEMPTS=3
EHTG_ANALYSIS_RETRY_SECONDS=5
# Set on the server only; never paste a real bot token into Git.
# EHTG_BOT_TOKEN=123456:replace_with_token_from_BotFather
EHTG_FILES_PATH=data/files
EHTG_MEDIA_MAX_BYTES=30000000
EHTG_MEDIA_MAX_PIXELS=40000000
EHTG_JOB_MAX_BYTES=1000000000
EHTG_MIN_FREE_BYTES=500000000
EHTG_MEDIA_TIMEOUT=120
EHTG_MEDIA_REQUEST_INTERVAL=1
EHTG_JOB_MAX_ATTEMPTS=5
EHTG_FILE_RETENTION_SECONDS=86400
